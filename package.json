{
  "name": "qr-generator",
  "private": true,
  "version": "1.1.0",
  "scripts": {
    "clean": "rm -rf .next coverage node_modules tsconfig.tsbuildinfo",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "prepare": "husky install",
    "release": "standard-version",
    "test": "jest",
    "biome:format": "biome format --write src/",
    "biome:lint": "biome lint --write src/",
    "biome:lint:ci": "biome lint src/",
    "typescript:ci": "tsc --noEmit",
    "test:ci": "jest --ci --collect-coverage --verbose"
  },
  "dependencies": {
    "@fontsource/catamaran": "^5.2.5",
    "@tailwindcss/forms": "0.5.10",
    "clsx": "^2.1.1",
    "html-to-image": "1.11.13",
    "next": "13.5.8",
    "next-seo": "5.15.0",
    "next-themes": "^0.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-icons": "4.12.0",
    "react-qrcode-logo": "2.10.0",
    "tailwind-merge": "1.14.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@commitlint/cli": "19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/react": "^18.0.28",
    "autoprefixer": "^10.4.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "^13.4.1",
    "eslint-config-yehezgun": "^1.2.6",
    "husky": "^9.1.7",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "lint-staged": "^15.5.0",
    "postcss": "8.5.3",
    "prettier": "^2.8.8",
    "prettier-plugin-tailwindcss": "0.1.13",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write src/"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write src/"
    ]
  },
  "packageManager": "pnpm@9.7.0+sha512.dc09430156b427f5ecfc79888899e1c39d2d690f004be70e05230b72cb173d96839587545d09429b55ac3c429c801b4dc3c0e002f653830a420fa2dd4e3cf9cf"
}
